---
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class="relative w-full border-t border-primary/10 px-5 pt-8 pb-10 text-center"
>
  <!-- Top glow line -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 h-px w-48 bg-gradient-to-r from-transparent via-primary/50 to-transparent"></div>

  <ul class="mb-6 flex flex-wrap justify-center gap-1">
    {
      socialLinks.map(({ text, href }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-1.5 rounded-full border border-transparent px-4 py-2 text-xs font-medium text-neutral transition-all duration-200 hover:border-primary/20 hover:bg-primary/5 hover:text-primary"
          >
            <svg class="h-3.5 w-3.5 opacity-60 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            {text}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="text-xs text-neutral/50">
    Built with <span class="text-primary">♥</span> by {author} · {currentYear}
  </p>
</footer>
