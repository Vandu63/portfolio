---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Work Experience" href="experience">
  <div class="relative">
    <!-- Vertical timeline line -->
    <div class="absolute left-0 top-0 bottom-0 w-px bg-gradient-to-b from-primary/60 via-primary/20 to-transparent ml-5 hidden md:block"></div>

    {
      experience.map(({ company, position, startDate, endDate, summary }, idx) => (
        <div class="group relative mb-10 md:pl-16">
          <!-- Timeline dot -->
          <div class="absolute left-0 top-1 hidden md:flex h-10 w-10 items-center justify-center rounded-full border border-primary/30 bg-surface ring-4 ring-black transition-all duration-300 group-hover:border-primary/70 group-hover:ring-primary/10">
            <div class="h-2.5 w-2.5 rounded-full bg-primary transition-transform duration-300 group-hover:scale-125"></div>
          </div>

          <!-- Card -->
          <div class="glass glass-hover rounded-2xl p-6 transition-all duration-300">
            <!-- Header -->
            <div class="mb-5 flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h3 class="font-serif text-xl font-semibold text-white">
                  {company}
                </h3>
                <h4 class="font-serif text-lg font-medium text-primary">
                  {position}
                </h4>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/15 bg-primary/8 px-3 py-1 text-xs text-neutral whitespace-nowrap mt-1 sm:mt-0 self-start">
                <svg class="h-3 w-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                {startDate} — {endDate}
              </span>
            </div>

            <!-- Summary -->
            {Array.isArray(summary) ? (
              <ul class="space-y-3">
                {summary.map((log) => (
                  <li class="flex items-start gap-3 text-base text-neutral">
                    <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-primary"></span>
                    <span>{log}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-base text-neutral">{summary}</p>
            )}
          </div>
        </div>
      ))
    }
  </div>
</Section>
