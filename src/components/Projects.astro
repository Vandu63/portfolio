---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  <div class="space-y-8">
    {
      projects.map(({ name, summary, image, linkPreview, linkSource, slug, techStack }, index) => {
        const isEven = index % 2 === 0;
        return (
          <div class="group border-glow relative overflow-hidden rounded-2xl border border-primary/10 bg-surface transition-all duration-500 hover:border-primary/25 hover:shadow-2xl hover:shadow-primary/10">
            <div class="pointer-events-none absolute inset-0 opacity-[3%]"
              style={{ backgroundImage: `url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")` }}>
            </div>

            <div class={`relative z-[1] grid min-h-[400px] grid-rows-[1fr_auto] md:grid-rows-1 md:grid-cols-2 md:min-h-[320px] ${isEven ? '' : 'md:[&>*:first-child]:order-2'}`}>
              <!-- Text side -->
              <div class="flex flex-col justify-between p-7 md:p-8">
                <div>
                  <!-- Project number -->
                  <span class="mb-3 block font-mono text-xs font-medium text-primary/50 tracking-widest">
                    {String(index + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}
                  </span>

                  <a href={`${import.meta.env.BASE_URL}projects/${slug}`} class="group/title block">
                    <h3 class="mb-3 font-serif text-2xl font-semibold text-white transition-all duration-300 group-hover/title:text-primary md:text-3xl">
                      {name}
                    </h3>
                  </a>
                  <p class="text-base text-neutral leading-relaxed">
                    {summary}
                  </p>

                  <!-- Tech stack pills -->
                  <div class="mt-5 flex flex-wrap gap-2">
                    {techStack.slice(0, 4).map((tech) => (
                      <span class="rounded-full border border-primary/15 bg-primary/8 px-2.5 py-0.5 text-xs text-primary/80">
                        {tech}
                      </span>
                    ))}
                    {techStack.length > 4 && (
                      <span class="rounded-full border border-neutral/20 bg-neutral/8 px-2.5 py-0.5 text-xs text-neutral/60">
                        +{techStack.length - 4} more
                      </span>
                    )}
                  </div>
                </div>

                <!-- Links -->
                <div class="mt-6 flex items-center gap-4">
                  <a
                    href={`${import.meta.env.BASE_URL}projects/${slug}`}
                    class="group/btn inline-flex items-center gap-2 text-sm font-medium text-primary transition-all duration-200 hover:gap-3"
                  >
                    View Details
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </a>
                  <span class="h-4 w-px bg-neutral/30"></span>
                  {linkSource && (
                    <a
                      href={linkSource}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm text-neutral transition-all duration-200 hover:text-white"
                    >
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                      </svg>
                      Source
                    </a>
                  )}
                  {linkPreview && (
                    <a
                      href={linkPreview}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm text-neutral transition-all duration-200 hover:text-white"
                    >
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                      Preview
                    </a>
                  )}
                </div>
              </div>

              <!-- Image side -->
              <div class="relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-t from-surface/80 via-transparent to-transparent z-10 md:bg-gradient-to-r md:from-surface/60 md:to-transparent"></div>
                <a href={`${import.meta.env.BASE_URL}projects/${slug}`} class="block h-full min-h-48 md:min-h-full">
                  <Image
                    class="h-full w-full object-cover object-left-top transition-transform duration-700 group-hover:scale-105"
                    src={image}
                    alt={name}
                    width="700"
                    height="400"
                  />
                </a>
                <!-- Corner accent -->
                <div class="absolute top-3 right-3 z-20 flex h-8 w-8 items-center justify-center rounded-full bg-black/50 backdrop-blur-sm border border-white/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                  <svg class="h-3.5 w-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </div>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>

  <div class="mt-10 text-center">
    <a
      href={`${import.meta.env.BASE_URL}projects`}
      class="group inline-flex items-center gap-2 rounded-full border border-primary/25 px-6 py-3 text-sm font-medium text-neutral transition-all duration-300 hover:border-primary/50 hover:text-white hover:bg-primary/5"
    >
      View All Projects
      <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</Section>
