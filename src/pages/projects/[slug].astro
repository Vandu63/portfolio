---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import VercelAnalytics from "../../components/VercelAnalytics.astro";
import { SITE_CONTENT, SITE_CONFIG } from "../../config";
import { Image } from "astro:assets";
import "@fontsource/be-vietnam-pro";
import "@fontsource-variable/gabarito";
import "../../styles/global.css";

export async function getStaticPaths() {
  return SITE_CONTENT.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { siteLogo, navLinks, author, socialLinks } = SITE_CONFIG;

const projectIndex = SITE_CONTENT.projects.findIndex((p) => p.slug === project.slug);
const prevProject = projectIndex > 0 ? SITE_CONTENT.projects[projectIndex - 1] : null;
const nextProject = projectIndex < SITE_CONTENT.projects.length - 1 ? SITE_CONTENT.projects[projectIndex + 1] : null;
---

<!doctype html>
<html lang="en" class="scroll-pt-16 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={project.summary} />
    <meta name="author" content={author} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{project.name} — Project Details</title>

    <meta property="og:title" content={`${project.name} — Project Details`} />
    <meta property="og:description" content={project.summary} />
    <meta property="og:image" content={project.image} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={`${project.name} — Project Details`} />
    <meta property="twitter:description" content={project.summary} />
    <meta property="twitter:image" content={project.image} />
  </head>
  <body class="bg-black font-sans text-white">
    <!-- Radial background gradient -->
    <div
      class="pointer-events-none fixed inset-0 z-0"
      style="background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(139,92,246,0.08) 0%, transparent 60%);"
    ></div>

    <div class="relative z-10">
      <Header siteLogo={siteLogo} navLinks={navLinks} />

      <main class="min-h-screen">
        <!-- Hero Banner -->
        <section class="relative h-[55vh] min-h-72 overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black z-10"></div>
          <Image
            src={project.image}
            alt={project.name}
            width={1400}
            height={600}
            class="h-full w-full object-cover scale-105"
          />
          <!-- Floating project info -->
          <div class="absolute inset-0 z-20 flex items-end">
            <div class="mx-auto w-full max-w-5xl px-6 pb-10">
              <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-primary/30 bg-black/50 px-3 py-1 text-xs text-primary backdrop-blur-sm">
                <span class="font-mono">{String(projectIndex + 1).padStart(2, '0')}</span>
                <span class="h-3 w-px bg-primary/40"></span>
                Project Details
              </div>
              <h1 class="mb-2 font-serif text-4xl font-bold text-white md:text-6xl">
                {project.name}
              </h1>
              <p class="max-w-2xl text-base text-white/70 md:text-lg">
                {project.summary}
              </p>
            </div>
          </div>
        </section>

        <!-- Content -->
        <section class="mx-auto max-w-5xl px-6 py-16">
          <div class="grid gap-8 lg:grid-cols-[1fr_300px]">
            <!-- Main Content -->
            <div class="space-y-12">
              <!-- About -->
              <div>
                <h2 class="mb-5 flex items-center gap-3 font-serif text-2xl font-semibold text-white">
                  <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/15 text-primary">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                  About the Project
                </h2>
                <p class="text-base leading-relaxed text-neutral">
                  {project.description}
                </p>
              </div>

              <!-- Features -->
              <div>
                <h2 class="mb-5 flex items-center gap-3 font-serif text-2xl font-semibold text-white">
                  <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/15 text-primary">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  Key Features
                </h2>
                <div class="grid gap-3 sm:grid-cols-2">
                  {
                    project.features.map((feature) => (
                      <div class="glass glass-hover flex items-start gap-3 rounded-xl p-4">
                        <div class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-primary"></div>
                        <p class="text-sm text-neutral leading-relaxed">{feature}</p>
                      </div>
                    ))
                  }
                </div>
              </div>

              <!-- Challenges & Learnings -->
              {
                (project.challenges || project.learnings) && (
                  <div class="grid gap-8 md:grid-cols-2">
                    {project.challenges && (
                      <div>
                        <h2 class="mb-5 flex items-center gap-3 font-serif text-2xl font-semibold text-white">
                          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-orange-500/15 text-orange-400">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                          </span>
                          Challenges
                        </h2>
                        <div class="space-y-3">
                          {project.challenges.map((challenge) => (
                            <div class="glass rounded-xl p-4">
                              <p class="text-sm text-neutral leading-relaxed">{challenge}</p>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                    {project.learnings && (
                      <div>
                        <h2 class="mb-5 flex items-center gap-3 font-serif text-2xl font-semibold text-white">
                          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/15 text-emerald-400">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                            </svg>
                          </span>
                          Learnings
                        </h2>
                        <div class="space-y-3">
                          {project.learnings.map((learning) => (
                            <div class="glass rounded-xl p-4">
                              <p class="text-sm text-neutral leading-relaxed">{learning}</p>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                )
              }
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
              <!-- Project Links -->
              <div class="glass rounded-2xl p-5">
                <h3 class="mb-4 font-serif text-base font-semibold text-white">Project Links</h3>
                <div class="space-y-3">
                  {
                    project.linkPreview && (
                      <a
                        href={project.linkPreview}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex items-center gap-3 rounded-xl bg-primary px-4 py-3 font-medium text-white text-sm transition-all duration-200 hover:bg-primary-dark hover:shadow-lg hover:shadow-primary/20"
                      >
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        Live Preview
                        <svg class="ml-auto h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    )
                  }
                  {
                    project.linkSource && (
                      <a
                        href={project.linkSource}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex items-center gap-3 rounded-xl border border-primary/20 px-4 py-3 text-sm font-medium text-neutral transition-all duration-200 hover:border-primary/40 hover:text-white hover:bg-primary/5"
                      >
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                        </svg>
                        View Source
                        <svg class="ml-auto h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    )
                  }
                </div>
              </div>

              <!-- My Role -->
              <div class="glass rounded-2xl p-5">
                <h3 class="mb-2 font-serif text-base font-semibold text-white">My Role</h3>
                <p class="text-sm text-neutral">{project.myRole}</p>
              </div>

              <!-- Tech Stack -->
              <div class="glass rounded-2xl p-5">
                <h3 class="mb-4 font-serif text-base font-semibold text-white">Tech Stack</h3>
                <div class="flex flex-wrap gap-2">
                  {
                    project.techStack.map((tech) => (
                      <span class="rounded-full border border-primary/20 bg-primary/8 px-3 py-1 text-xs text-primary/80 transition-all duration-200 hover:border-primary/40 hover:bg-primary/15 hover:text-primary cursor-default">
                        {tech}
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Project Navigation -->
        <section class="mx-auto max-w-5xl border-t border-primary/10 px-6 py-10">
          <div class="flex items-center justify-between gap-4">
            {
              prevProject ? (
                <a
                  href={`${import.meta.env.BASE_URL}projects/${prevProject.slug}`}
                  class="group flex items-center gap-3 rounded-xl border border-primary/15 px-4 py-3 text-sm text-neutral transition-all duration-200 hover:border-primary/35 hover:text-white hover:bg-primary/5"
                >
                  <svg class="h-4 w-4 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                  <span>{prevProject.name}</span>
                </a>
              ) : (
                <div></div>
              )
            }
            <a
              href={`${import.meta.env.BASE_URL}projects`}
              class="group flex items-center gap-2 text-sm text-neutral transition-all duration-200 hover:text-white"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
              </svg>
              All Projects
            </a>
            {
              nextProject ? (
                <a
                  href={`${import.meta.env.BASE_URL}projects/${nextProject.slug}`}
                  class="group flex items-center gap-3 rounded-xl border border-primary/15 px-4 py-3 text-sm text-neutral transition-all duration-200 hover:border-primary/35 hover:text-white hover:bg-primary/5"
                >
                  <span>{nextProject.name}</span>
                  <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ) : (
                <div></div>
              )
            }
          </div>
        </section>
      </main>

      <Footer author={author} socialLinks={socialLinks} />
    </div>
    <VercelAnalytics />
  </body>
</html>
