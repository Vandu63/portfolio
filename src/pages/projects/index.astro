---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import VercelAnalytics from "../../components/VercelAnalytics.astro";
import { SITE_CONTENT, SITE_CONFIG } from "../../config";
import { Image } from "astro:assets";
import "@fontsource/be-vietnam-pro";
import "@fontsource-variable/gabarito";
import "../../styles/global.css";

const { projects } = SITE_CONTENT;
const { siteLogo, navLinks, author, socialLinks } = SITE_CONFIG;
---

<!doctype html>
<html lang="en" class="scroll-pt-16 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="A collection of projects showcasing skills in backend development, AI integration, and full-stack applications."
    />
    <meta name="author" content={author} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Projects — {author}</title>

    <meta property="og:title" content={`Projects — ${author}`} />
    <meta
      property="og:description"
      content="A collection of projects showcasing skills in backend development, AI integration, and full-stack applications."
    />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={`Projects — ${author}`} />
    <meta
      property="twitter:description"
      content="A collection of projects showcasing skills in backend development, AI integration, and full-stack applications."
    />
  </head>
  <body class="bg-black font-sans">
    <!-- Radial background gradient -->
    <div
      class="pointer-events-none fixed inset-0 z-0"
      style="background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(139,92,246,0.08) 0%, transparent 60%), radial-gradient(ellipse 50% 40% at 80% 80%, rgba(109,40,217,0.05) 0%, transparent 50%);"
    ></div>

    <div class="relative z-10">
      <Header siteLogo={siteLogo} navLinks={navLinks} />

      <main class="min-h-screen text-white">
        <!-- Hero Section -->
        <section class="relative mx-auto max-w-6xl overflow-hidden px-6 py-20 md:py-28">
          <!-- Decorative blobs -->
          <div class="pointer-events-none absolute -top-20 left-0 w-80 h-80 rounded-full bg-primary/5 blur-3xl"></div>
          <div class="pointer-events-none absolute bottom-0 right-0 w-60 h-60 rounded-full bg-violet-600/4 blur-3xl"></div>

          <div class="relative text-center">
            <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-sm text-primary backdrop-blur-sm">
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              {projects.length} Projects
            </div>
            <h1 class="mb-6 font-serif text-5xl font-bold md:text-7xl">
              <span class="text-white">My </span>
              <span class="text-gradient">Projects</span>
            </h1>
            <p class="mx-auto max-w-xl text-lg text-neutral leading-relaxed">
              A curated selection of projects showcasing my skills in backend
              development, AI integration, and full-stack engineering.
            </p>
          </div>
        </section>

        <!-- Projects Grid -->
        <section class="mx-auto max-w-6xl px-6 pb-20">
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
              projects.map((project, idx) => (
                <article class="group border-glow relative overflow-hidden rounded-2xl border border-primary/10 bg-surface transition-all duration-400 hover:border-primary/30 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1">
                  <!-- Image -->
                  <div class="relative overflow-hidden">
                    <Image
                      src={project.image}
                      alt={project.name}
                      width={400}
                      height={220}
                      class="h-44 w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/20 to-transparent opacity-60"></div>
                    <!-- Index badge -->
                    <div class="absolute top-3 left-3 flex h-7 w-7 items-center justify-center rounded-full bg-black/60 backdrop-blur-sm border border-white/10 text-xs font-mono font-bold text-primary">
                      {String(idx + 1).padStart(2, '0')}
                    </div>
                  </div>

                  <!-- Content -->
                  <div class="p-5">
                    <a href={`/projects/${project.slug}`} class="block">
                      <h3 class="mb-2 font-serif text-xl font-semibold text-white transition-colors duration-200 group-hover:text-primary">
                        {project.name}
                      </h3>
                    </a>
                    <p class="mb-4 text-sm text-neutral line-clamp-2 leading-relaxed">
                      {project.summary}
                    </p>

                    <!-- Tech stack -->
                    <div class="mb-4 flex flex-wrap gap-1.5">
                      {project.techStack.slice(0, 3).map((tech) => (
                        <span class="rounded-full border border-primary/15 bg-primary/8 px-2 py-0.5 text-[11px] text-primary/70">
                          {tech}
                        </span>
                      ))}
                      {project.techStack.length > 3 && (
                        <span class="rounded-full border border-neutral/20 bg-neutral/5 px-2 py-0.5 text-[11px] text-neutral/50">
                          +{project.techStack.length - 3}
                        </span>
                      )}
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center justify-between">
                      <a
                        href={`/projects/${project.slug}`}
                        class="inline-flex items-center gap-1.5 text-xs font-medium text-primary transition-all duration-200 hover:gap-2.5"
                      >
                        View Details
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                      </a>
                      <div class="flex gap-2">
                        {project.linkSource && (
                          <a
                            href={project.linkSource}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex h-7 w-7 items-center justify-center rounded-full border border-neutral/20 text-neutral transition-all duration-200 hover:border-primary/30 hover:text-primary hover:bg-primary/5"
                            title="View source"
                          >
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                            </svg>
                          </a>
                        )}
                        {project.linkPreview && (
                          <a
                            href={project.linkPreview}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex h-7 w-7 items-center justify-center rounded-full border border-neutral/20 text-neutral transition-all duration-200 hover:border-primary/30 hover:text-primary hover:bg-primary/5"
                            title="Live preview"
                          >
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <!-- Back to Home -->
        <section class="mx-auto max-w-6xl px-6 pb-16 text-center">
          <a
            href="/"
            class="group inline-flex items-center gap-2 text-sm text-neutral transition-all duration-200 hover:text-white"
          >
            <svg
              class="h-4 w-4 transition-transform duration-200 group-hover:-translate-x-0.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"
              ></path>
            </svg>
            <span>Back to Home</span>
          </a>
        </section>
      </main>

      <Footer author={author} socialLinks={socialLinks} />
    </div>
    <VercelAnalytics />
  </body>
</html>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
